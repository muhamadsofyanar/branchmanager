# Salin menjadi .env. Jangan unggah .env ke GitHub.
APP_URL=https://belajar.stifinmulia.com
ADMIN_EMAIL=cs@stifinmulia.com
# Wajib diisi sendiri. Minimal 12 karakter; gunakan 20+ karakter acak.
ADMIN_PASSWORD=
COOKIE_SECURE=true
# true hanya jika aplikasi di belakang reverse proxy tepercaya dan port langsung ditutup.
TRUST_PROXY=false
HOST_PORT=3000
